{
  "name": "pi-vigil",
  "version": "0.1.0",
  "description": "Pi extension for asynchronous, turn-based subagents",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:acceptance": "vitest run --project acceptance",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.75.0",
    "@earendil-works/pi-coding-agent": ">=0.75.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
