{
  "name": "pi-vigil",
  "version": "0.2.0",
  "description": "Pi extension for asynchronous, turn-based subagents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itgeorge/pi-vigil.git"
  },
  "bugs": {
    "url": "https://github.com/itgeorge/pi-vigil/issues"
  },
  "homepage": "https://github.com/itgeorge/pi-vigil#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "vigil",
    "subagent",
    "subagents",
    "coding-agent",
    "async",
    "orchestration"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:acceptance": "vitest run --project acceptance",
    "test:faux": "vitest run --project faux-acceptance",
    "typecheck": "tsc --noEmit",
    "pack:verify": "node --experimental-strip-types scripts/verify-package-surface.ts",
    "check": "npm run typecheck && npm test && npm run test:faux && npm run pack:verify",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
